# Fightcraft .gitignore (Flutter, Android only)

# ---- Flutter / Dart build output and tooling ----
.dart_tool/
.packages
.pub-cache/
.pub/
/build/
.flutter-plugins
.flutter-plugins-dependencies
.fvm/
coverage/
*.log

# Generated by Flutter; regenerated on build
**/generated_plugin_registrant.*
**/GeneratedPluginRegistrant.*

# Symbolication / obfuscation maps
app.*.symbols
app.*.map.json

# ---- Android ----
/android/.gradle/
/android/.kotlin/
/android/captures/
/android/app/debug/
/android/app/profile/
/android/app/release/
/android/local.properties
/android/gradle-wrapper.jar
/android/key.properties
/android/app/.cxx/
*.iml
*.jks
*.keystore
*.apk
*.aab

# ---- IDEs ----
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
*.swp
.history/

# ---- OS junk ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Secrets and local config (never commit) ----
.env
.env.*
*.pem

# ---- Project-specific scratch ----
tools/out/
tmp/